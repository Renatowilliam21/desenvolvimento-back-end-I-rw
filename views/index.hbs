<h1 class="mb-3">Oficinas cadastradas</h1>

<p class="mb-3">
    Total de oficinas: <b>{{resumo.total}}</b>
    &nbsp; Abertas: <b>{{resumo.abertas}}</b>
    &nbsp; Encerradas: <b>{{resumo.encerradas}}</b>
    &nbsp; Carga horária das abertas: <b>{{resumo.carga_abertas}} h</b>
</p>

<ul class="nav nav-pills mb-3">
    <li class="nav-item">
        <a class="nav-link {{#unless somente_abertas}}active{{/unless}}" href="/">Todas as Oficinas</a>
    </li>
    <li class="nav-item">
        <a class="nav-link {{#if somente_abertas}}active{{/if}}" href="/abertas">Inscrições Abertas</a>
    </li>
</ul>

{{#if catalogo_vazio}}
    <p>Nenhuma oficina cadastrada.</p>
    <a class="btn btn-primary" href="/oficina/cria">Cadastrar a primeira oficina</a>
{{else if sem_abertas}}
    <p>Nenhuma oficina está com inscrições abertas</p>
{{else}}
    <table class="table table-hover align-middle">
        <thead class="table-primary text-center">
            <tr>
                <th>Título</th>
                <th>Carga horária</th>
                <th>Inscrições</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            {{#each oficinas}}
                <tr>
                    <td><b>{{this.titulo}}</b></td>
                    <td class="text-center">{{this.carga_horaria}} h</td>
                    <td class="text-center">{{#if this.aberta}}Abertas{{else}}Encerradas{{/if}}</td>
                    <td class="text-center">
                        <a class="btn btn-primary btn-sm" href="/oficina/consulta/{{this.id}}">Consultar</a>
                        <a class="btn btn-primary btn-sm" href="/oficina/altera/{{this.id}}">Editar</a>
                        <button type="button" class="btn btn-danger btn-sm" data-bs-toggle="modal" data-bs-target="#modalExclui{{this.id}}">Excluir</button>
                        {{#if this.aberta}}
                            <a class="btn btn-outline-primary btn-sm" href="/oficina/encerra/{{this.id}}">Encerrar</a>
                        {{else}}
                            <a class="btn btn-outline-primary btn-sm" href="/oficina/reabre/{{this.id}}">Reabrir</a>
                        {{/if}}
                    </td>
                </tr>
            {{/each}}
        </tbody>
    </table>

    {{#each oficinas}}
        <div class="modal fade" id="modalExclui{{this.id}}" tabindex="-1" aria-labelledby="tituloModal{{this.id}}" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h1 class="modal-title fs-6" id="tituloModal{{this.id}}">Excluir oficina</h1>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                    </div>
                    <div class="modal-body">
                        Confirma a exclusão de <b>{{this.titulo}}</b>?
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <a class="btn btn-danger" href="/oficina/deleta/{{this.id}}">Confirmar</a>
                    </div>
                </div>
            </div>
        </div>
    {{/each}}
{{/if}}
